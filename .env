# Defaults this repository ships -- override in .env.local (gitignored).
# Everything here is read in src/forumboard/agent/config.py, which is the only
# module that touches the environment.

# ---------------------------------------------------------------------------
# Notion — written by `forumboard setup notion`, which creates the databases.
# `forumboard doctor` says whether the token and both schemas are usable.
# ---------------------------------------------------------------------------
# NOTION_TOKEN=ntn_...
# NOTION_PARENT_PAGE_ID=...          # only the setup wizard reads this
# NOTION_DISCUSSIONS_DATABASE_ID=...
# NOTION_WORLDVIEW_DATABASE_ID=...

# ---------------------------------------------------------------------------
# Pipeline cadence
# ---------------------------------------------------------------------------
# How often each loop runs. The worldview reads every unmerged discussion at
# once, so it batches rather than matching the sync interval.
# FORUMBOARD_SYNC_INTERVAL_SECONDS=900
# FORUMBOARD_WORLDVIEW_INTERVAL_SECONDS=3600

# How far back a newly enrolled profile reaches on its first pass, so
# enrolling somebody does not import their whole history. An account quieter
# than that window would seed nothing, so the first pass reaches past it for
# the newest few; zero leaves the window as the only rule.
# FORUMBOARD_SYNC_LOOKBACK_DAYS=7
# FORUMBOARD_SYNC_SEED_CONVERSATIONS=10
# FORUMBOARD_SYNC_MAX_CONVERSATIONS=20

# Briefing windows written into the discussion database, comma-separated:
# daily, weekly, monthly, quarterly.
# FORUMBOARD_BRIEFING_CADENCES=weekly,monthly

# Transcripts up to this size are edited in one pass, which is what lets the
# editor judge the whole conversation at once. Past it the editor works in
# sequential chunks — never truncated, because that would drop content
# silently.
# FORUMBOARD_EDITOR_WHOLE_TRANSCRIPT_CHARS=400000

# The reviewer and the editor print their blocks as each message completes, so
# a pass reading a long transcript is visibly working rather than
# indistinguishable from a hung one. Turn this off wherever the terminal is
# durable and shared — a daemon under systemd, or CI — because a pass reasons
# about the raw conversation before it has redacted anything, and its thinking
# quotes what it is deciding to remove.
# FORUMBOARD_STREAM_AGENT_BLOCKS=true

# ---------------------------------------------------------------------------
# Enrolment surface (`forumboard serve`)
# ---------------------------------------------------------------------------
# Loopback by default: the page drives a browser holding somebody's live
# claude.ai session and carries a Notion secret, so exposing it is deliberate.
# FORUMBOARD_WEB_HOST=127.0.0.1
# FORUMBOARD_WEB_PORT=8781

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# The reviewer, the editor, and the worldview agent all run on this tier. The
# redaction call is the last place to want a cheaper model.
# AGENT_MODEL=claude-opus-5
# AGENT_SDK routes the engine explicitly; unset routes by the AGENT_MODEL
# vendor prefix (claude-* -> claude, gpt-*/o<digit>*/codex* -> codex, else
# claude-compat with OPENROUTER_API_KEY or openai-compat otherwise).
# AGENT_SDK=claude
# AGENT_MAX_THINKING_TOKENS=127999
# AGENT_MAX_BUDGET_USD=5.00
# AGENT_MAX_TURNS=50
# Claude tier: AGENT_MAX_TURNS, AGENT_MAX_THINKING_TOKENS, and
# AGENT_PERMISSION_MODE raise when set explicitly on AGENT_SDK=codex/openai.
# Codex tier: AGENT_TURN_TIMEOUT_SECONDS (wall-clock cap on a single turn,
# the codex/openai substitute for max_turns) raises on AGENT_SDK=claude.
# AGENT_TURN_TIMEOUT_SECONDS=900

# Codex/OpenAI backend pricing — required for AGENT_MAX_BUDGET_USD on
# AGENT_SDK=codex/openai, because the Codex SDK reports tokens, not cost.
# CODEX_USD_PER_MTOK_INPUT=1.25
# CODEX_USD_PER_MTOK_OUTPUT=10.00
# CODEX_USD_PER_MTOK_CACHED_INPUT=0.125

# Auxiliary model (the topic-drafter subagent). Defaults to backend-native:
# an opus-class model on claude, the session model on codex/openai.
# AGENT_AUX_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Raw transcripts and sync cursors live under the notes path, which is
# gitignored. They are unredacted by definition — they are the input to
# redaction — so they never reach a commit.
# AGENT_NOTES_PATH=./notes
# AGENT_LOGS_PATH=./logs
# Extra read-access directories for the agent, colon-separated
# AGENT_EXTRA_DIRS=/abs/reference-data:/abs/other

# Timezone briefing windows are named in.
# AGENT_TIMEZONE=Europe/Paris

# Where Playwright keeps the browser a login runs in. Playwright's own
# variable, read through settings so `forumboard setup browser` and the
# browser it checks for cannot disagree about the location. Unset uses the
# per-platform default (~/.cache/ms-playwright on Linux).
# PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
