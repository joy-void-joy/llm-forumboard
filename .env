# Template defaults -- override in .env.local (gitignored)

# Optional - Model settings (defaults: opus 5, 128k-1 thinking tokens)
# AGENT_MODEL=claude-opus-5
# AGENT_SDK routes the engine explicitly; unset routes by the AGENT_MODEL
# vendor prefix (claude-* -> claude, gpt-*/o<digit>*/codex* -> codex, else
# claude-compat with OPENROUTER_API_KEY or openai-compat otherwise).
# AGENT_SDK=claude
# AGENT_MAX_THINKING_TOKENS=127999
# AGENT_MAX_BUDGET_USD=5.00
# AGENT_MAX_TURNS=50
# Claude tier: AGENT_MAX_TURNS, AGENT_MAX_THINKING_TOKENS, and
# AGENT_PERMISSION_MODE raise when set explicitly on AGENT_SDK=codex/openai.
# Codex tier: AGENT_TURN_TIMEOUT_SECONDS (wall-clock cap on a single turn,
# the codex/openai substitute for max_turns) raises on AGENT_SDK=claude.
# AGENT_TURN_TIMEOUT_SECONDS=900

# Optional - Codex/OpenAI backend pricing (required for AGENT_MAX_BUDGET_USD
# on AGENT_SDK=codex/openai: the Codex SDK reports tokens, not cost)
# CODEX_USD_PER_MTOK_INPUT=1.25
# CODEX_USD_PER_MTOK_OUTPUT=10.00
# CODEX_USD_PER_MTOK_CACHED_INPUT=0.125
#
# Optional - Auxiliary model (reviewer, background agents). Default is
# backend-native: an opus-class reviewer on claude, the session model on
# codex/openai — single-provider out of the box. A non-Claude reviewer
# degrades to a one-shot text critique (no file tools).
# AGENT_AUX_MODEL=claude-sonnet-4-6
#
# Note: the template's subagent specs (researcher/analyzer) pin Anthropic
# models and need Anthropic creds on codex/openai unless you change them.

# Optional - Sandbox (Docker; disable to run without code execution tools)
# AGENT_SANDBOX_ENABLED=true

# Optional - Paths
# AGENT_NOTES_PATH=./notes
# AGENT_LOGS_PATH=./logs
# Extra read-access directories for the agent, colon-separated
# AGENT_EXTRA_DIRS=/abs/reference-data:/abs/other

# Domain-specific API keys (add as needed)
# EXA_API_KEY=your-exa-key
# FRED_API_KEY=your-fred-key
